{
  "name": "pln-plan",
  "displayName": "Plan (.pln)",
  "description": "Visual project list editor for .pln plan files",
  "version": "0.1.0",
  "publisher": "emanuelaromano",
  "license": "MIT",
  "icon": "icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/emanuelaromano/pln.git"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "main": "./out/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "pln",
        "aliases": [
          "Plan"
        ],
        "extensions": [
          ".pln"
        ]
      }
    ],
    "customEditors": [
      {
        "viewType": "pln.planEditor",
        "displayName": "Plan",
        "selector": [
          {
            "filenamePattern": "*.pln"
          }
        ],
        "priority": "default"
      }
    ]
  },
  "scripts": {
    "compile": "esbuild src/extension.ts --bundle --outfile=out/extension.js --external:vscode --format=cjs --platform=node --sourcemap",
    "watch": "npm run compile -- --watch",
    "check": "tsc --noEmit",
    "git": "git add . && printf 'Commit message [update]: ' && read msg && git commit -m \"${msg:-update}\" && git push",
    "test": "npm run compile && node --test test/plan.test.js"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.85.0",
    "esbuild": "^0.20.0",
    "typescript": "^5.3.3"
  }
}
